//! unsyn for `unsyn`

whitespace S -> [
      U+0009-U+000D
    , U+0020
    , U+0085
    , U+00A0
    , U+1680
    , U+2000-U+200A
    , U+2028
    , U+2029
    , U+202F
    , U+205F
    , U+3000
];

lexer LF  -> U+000A;
lexer CR  -> U+000D;

lexer IdentOrKeyword -> ( XID_Start | '_' ) XID_Continue*;

lexer XID_Start -> <XID_Start>;

lexer XID_Continue -> <XID_Continue>;

lexer RawIdent -> 'r#' IdentOrKeyword;

lexer NonKeywordIdent -> IdentOrKeyword except Keywords;

lexer Ident -> NonKeywordIdent | RawIdent;

lexer Keywords ->
      LeadingKeywords
    | FollowingKeywords
    ;

lexer LeadingKeywords ->
      'lexer'
    | 'syntax'
    | 'whitespace'
    ;

lexer FollowingKeywords ->
      'concat'
    | 'except'
    | 'followed'
    ;

lexer LitStr ->
    '\'' (
        ~['"','\\',CR]
      | QuoteEscape
      | AsciiEscape
      | UnicodeEscape
    )* '\''
    ;

lexer QuoteEscape -> '\\\'';

lexer AsciiEscape ->
      '\\x' OctDigit HexDigit
    | '\\n'
    | '\\r'
    | '\\t'
    | '\\\\'
    | '\\0'
    ;

lexer UnicodeEscape ->
    '\\u{' ( HexDigit '_'* ){1, 6} '}'
    ;

lexer OctDigit -> ['0'-'7'];
lexer DecDigit -> ['0'-'9'];
lexer HexDigit -> ['0'-'9','a'-'f','A'-'F'];

lexer LitDec -> DecDigit ( DecDigit | '_' )*;

lexer LitUnicode -> 'U+' concat HexDigit{4};

lexer LineComment ->
    '//' (~['/','!',LF] | '//') ~[LF]*
    ;

lexer BlockComment ->
      '/*'
        ( ~['*','!','/*'] | '**' | BlockCommentOrDoc )
        ( BlockCommentOrDoc | ~['/*','*/'] )*
      '*/'
    | '/**/'
    | '/***/'
    ;

lexer InnerLineDoc -> '//!' ~[LF,CR];

lexer InnerBlockDoc ->
    '/*!' ( BlockCommentOrDoc | ~['/*','*/'] )* '*/'
    ;

lexer OuterLineDoc ->
    '///' ( ~['/'] ~[LF,CR]* )?
    ;

lexer OuterBlockDoc ->
    '/**'
      ( ~['*','/*'] | BlockCommentOrDoc )
      ( BlockCommentOrDoc | ~['/*','*/'] )*
    '*/'
    ;

lexer BlockCommentOrDoc ->
      BlockComment
    | OuterBlockDoc
    | InnerBlockDoc
    ;


syntax Expr -> ExprNoTopAlt+ ( '|' ExprNoTopAlt+ )?;

syntax ExprNoTopAlt -> ExprWithSuffix | ExprWithoutSuffix;

syntax ExprWithoutSuffix ->
      '~' '[' ( SetItem ',' )* SetItem? ']'
    | '<' Ident '>'
    | '(' Expr ')'
    | '[' ( SetItem ',' )* SetItem? ']'
    | LitStr
    | LitUnicode
    | Ident
    ;

syntax ExprWithSuffix ->
      ExprWithoutSuffix
      (
          '*'
        | '?'
        | '+'
        | Repeat
      )
    | ExprWithoutSuffix 'concat' ExprNoTopAlt
    | ExprWithoutSuffix 'followed' ExprNoTopAlt
    | ExprWithoutSuffix 'except' ExprWithoutSuffix
    ;

syntax Repeat ->
    '{'
    (
          ',' LitDec
        | LitDec ',' LitDec?
        | LitDec
    )
    '}'
    ;

syntax Range ->
      LitUnicode '-' LitUnicode
    | LitStr concat '-' concat LitStr
    ;

syntax SetItem ->
      Range
    | LitStr
    | LitUnicode
    | Ident
    ;

syntax Stmt -> LeadingKeywords Ident '->' Expr ';';

syntax Item -> OuterDoc | S | Stmt;

syntax OuterDoc -> OuterBlockDoc | OuterLineDoc;

syntax InnerDoc -> InnerBlockDoc | InnerLineDoc;

syntax Crate -> InnerDoc* Item*;
