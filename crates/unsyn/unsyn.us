//! unsyn for `unsyn`

whitespace S -> [
      U+0009-U+000D
    , U+0020
    , U+0085
    , U+00A0
    , U+1680
    , U+2000-U+200A
    , U+2028
    , U+2029
    , U+202F
    , U+205F
    , U+3000
];

lexer LF  -> U+000A;
lexer CR  -> U+000D;

lexer IdentOrKeyword -> <IdentOrKeyword>;

lexer RawIdent -> 'r#' NonKeywordIdent;

lexer NonKeywordIdent -> IdentOrKeyword except Keywords;

lexer Ident -> RawIdent | NonKeywordIdent;

lexer Keywords ->
      LeadingKeywords
    | OperatorKeywords
    ;

lexer LeadingKeywords ->
      'lexer'
    | 'syntax'
    | 'whitespace'
    ;

lexer OperatorKeywords ->
      'concat'
    | 'except'
    ;

lexer LitStr ->
    '\'' (
        ~['\'', '\\', CR]
      | QuoteEscape
      | AsciiEscape
      | UnicodeEscape
    )* '\''
    ;

lexer QuoteEscape -> '\\\'';

lexer AsciiEscape ->
      AsciiHexEscape
    | '\\n'
    | '\\r'
    | '\\t'
    | '\\\\'
    | '\\0'
    ;

/// The escape of a code of seven bits, spelled by the two hex digits after
/// its marker.
lexer AsciiHexEscape -> '\\x' OctDigit HexDigit;

lexer UnicodeEscape ->
    '\\u{' HexDigit{1, 6} '}'
    ;

lexer OctDigit -> ['0'-'7'];
lexer DecDigit -> ['0'-'9'];
lexer HexDigit -> ['0'-'9','a'-'f','A'-'F'];

lexer LitDec -> DecDigit ( DecDigit | '_' )*;

lexer LitUnicode -> 'U+' HexDigit{4};

lexer BlockComment ->
      BlockCommentBody
    | '/**/'
    | '/***/'
    ;

/// A block comment that holds something: what it opens with, the one run that
/// cannot begin its end, then as many nested comments and further runs as it
/// takes, and the end itself.
///
/// The rule is a definition of its own because it is the one form of a comment
/// written of more than one operand; the two beside it are empty, and read as
/// the two words they are.
lexer BlockCommentBody ->
    '/*'
      ( ~( '*' | '!' | '/*' ) | '**' | BlockCommentOrDoc )
      ( BlockCommentOrDoc | ~( '/*' | '*/' ) )*
    '*/'
    ;

lexer InnerLineDoc -> '//!' ~[LF,CR]*;

lexer InnerBlockDoc ->
    '/*!' ( BlockCommentOrDoc | ~( '/*' | '*/' ) )* '*/'
    ;

lexer OuterLineDoc ->
    '///' ( ~['/'] ~[LF,CR]* )?
    ;

lexer OuterBlockDoc ->
    '/**'
      ( ~( '*' | '/*' ) | BlockCommentOrDoc )
      ( BlockCommentOrDoc | ~( '/*' | '*/' ) )*
    '*/'
    ;

lexer BlockCommentOrDoc ->
      BlockComment
    | OuterBlockDoc
    | InnerBlockDoc
    ;


syntax Expr -> ExprNoTopAlt+ ( '|' ExprNoTopAlt+ )*;

syntax ExprNoTopAlt -> ExprWithSuffix | ExprWithoutSuffix;

/// A list of the characters one position may hold.
///
/// Every member denotes a single character and at least one — a one-character
/// literal, a code point, a range of them, or a name settling down to one —
/// which is what makes a set one test of one character, neither wider nor
/// empty. What denotes more than a character is a choice of its own, and `~`
/// refuses any operand; what denotes nothing is no answer to a set at all.
syntax Set -> '[' ( SetItem ',' )* SetItem? ']';

syntax ExprWithoutSuffix ->
      NegatedSet
    | Call
    | Paren
    | Set
    | LitStr
    | LitUnicode
    | Ident
    ;

/// An operand refused: the character read here is the one the operand must
/// not begin.
///
/// A rule of its own because the refusal is a node of the tree: the operand
/// the reader probes and the character it then takes. Refusing a set of
/// single characters settles as one test of the character beside them; what
/// the operand reaches wider is probed as whatever it is, and refused
/// entirely before the one character after it is taken.
///
/// A suffix written beside the `~` stands on the refusal and not under it,
/// which is what lets a refusal repeat — `~[LF,CR]*` refuses one character as
/// often as it can — and what leaves the operand of a refusal with no
/// quantity of its own to refuse. The one operand that can still be refused
/// wrongly is a name: a rule matched by nothing begins everywhere, and the
/// refusal of it is satisfied by nothing.
syntax NegatedSet -> '~' ExprWithoutSuffix;

/// An external the caller of the parser binds, named between `<` and `>`.
///
/// The name here is not a rule of the file, and so names no definition; the
/// node it reads is the caller's, and this rule holds the pair of brackets
/// and the name between them.
syntax Call -> '<' Ident '>';

/// An expression grouped so that it may stand as one operand, take a suffix
/// as one, or be joined to another as one.
syntax Paren -> '(' Expr ')';

/// How many times an operand is read: as many as please, at most once, at
/// least once, or a bounded number of times.
syntax Suffix ->
      '*'
    | '?'
    | '+'
    | Repeat
    ;

syntax ExprWithSuffix ->
      Suffixed
    | ExprWithoutSuffix 'concat' ExprNoTopAlt
    | ExprWithoutSuffix 'except' ExprWithoutSuffix
    ;

/// An operand with one of the quantity operators written after it.
///
/// The two keywords beside it join and take away, and each says which by the
/// word it reads. This one reads no word, only the operator written as a mark,
/// so it is the rule that has to say what it is.
syntax Suffixed -> ExprWithoutSuffix Suffix;

/// The bounds a repetition is written with, which the reader of a pattern has
/// to tell apart: a number above, a number below, or a number of times.
syntax RepeatBound ->
      RangeTo
    | RangeFrom
    | LitDec
    ;

/// `,n`: a bound above, over a bound below that was left off.
syntax RangeTo -> ',' LitDec;

/// `n,m` or `n,`: a bound below, and the bound above it where one was written.
syntax RangeFrom -> LitDec ',' LitDec?;

syntax Repeat -> '{' RepeatBound '}';

syntax Range ->
      UnicodeRange
    | StrRange
    ;

/// A range whose two ends are both written as code points.
///
/// The two forms of a range reach for the same word, `concat`, so one of them
/// would be left named by its place alone; naming both says which end of a
/// range each was written from.
syntax UnicodeRange -> LitUnicode concat '-' concat LitUnicode;

/// A range whose two ends are both written as characters.
syntax StrRange -> LitStr concat '-' concat LitStr;


syntax SetItem ->
      Range
    | LitStr
    | LitUnicode
    | Ident
    ;

syntax Stmt -> LeadingKeywords Ident '->' Expr ';';

syntax Item -> OuterDoc | S | Stmt;

syntax OuterDoc -> OuterBlockDoc | OuterLineDoc;

syntax InnerDoc -> InnerBlockDoc | InnerLineDoc;

syntax Crate -> InnerDoc* Item*;
