//! unsyn for `unsyn`

whitespace S -> [
      U+0009-U+000D
    , U+0020
    , U+0085
    , U+00A0
    , U+1680
    , U+2000-U+200A
    , U+2028
    , U+2029
    , U+202F
    , U+205F
    , U+3000
];

lexer LF  -> U+000A;
lexer CR  -> U+000D;

lexer IdentOrKeyword -> <IdentOrKeyword>;

lexer RawIdent -> 'r#' IdentOrKeyword;

lexer NonKeywordIdent -> IdentOrKeyword except Keywords;

lexer Ident -> RawIdent | NonKeywordIdent;

lexer Keywords ->
      LeadingKeywords
    | FollowingKeywords
    ;

lexer LeadingKeywords ->
      'lexer'
    | 'syntax'
    | 'whitespace'
    ;

lexer FollowingKeywords ->
      'concat'
    | 'except'
    | 'followed'
    ;

lexer LitStr ->
    '\'' (
        ~['\'', '\\', CR]
      | QuoteEscape
      | AsciiEscape
      | UnicodeEscape
    )* '\''
    ;

lexer QuoteEscape -> '\\\'';

lexer AsciiEscape ->
      '\\x' OctDigit HexDigit
    | '\\n'
    | '\\r'
    | '\\t'
    | '\\\\'
    | '\\0'
    ;

lexer UnicodeEscape ->
    '\\u{' HexDigit{1, 6} '}'
    ;

lexer OctDigit -> ['0'-'7'];
lexer DecDigit -> ['0'-'9'];
lexer HexDigit -> ['0'-'9','a'-'f','A'-'F'];

lexer LitDec -> DecDigit ( DecDigit | '_' )*;

lexer LitUnicode -> 'U+' concat HexDigit{4};

lexer BlockComment ->
      '/*'
        ( ~['*','!','/*'] | '**' | BlockCommentOrDoc )
        ( BlockCommentOrDoc | ~['/*','*/'] )*
      '*/'
    | '/**/'
    | '/***/'
    ;

lexer InnerLineDoc -> '//!' ~[LF,CR]*;

lexer InnerBlockDoc ->
    '/*!' ( BlockCommentOrDoc | ~['/*','*/'] )* '*/'
    ;

lexer OuterLineDoc ->
    '///' ( ~['/'] ~[LF,CR]* )?
    ;

lexer OuterBlockDoc ->
    '/**'
      ( ~['*','/*'] | BlockCommentOrDoc )
      ( BlockCommentOrDoc | ~['/*','*/'] )*
    '*/'
    ;

lexer BlockCommentOrDoc ->
      BlockComment
    | OuterBlockDoc
    | InnerBlockDoc
    ;


syntax Expr -> ExprNoTopAlt+ ( '|' ExprNoTopAlt+ )*;

syntax ExprNoTopAlt -> ExprWithSuffix | ExprWithoutSuffix;

/// A list of the values one character can be drawn from.
///
/// The set is a rule of its own because a pattern asks about it in two ways:
/// as the values it denotes, and as the one character `~` refuses.
syntax Set -> '[' ( SetItem ',' )* SetItem? ']';

syntax ExprWithoutSuffix ->
      '~' Set
    | '<' Ident '>'
    | '(' Expr ')'
    | Set
    | LitStr
    | LitUnicode
    | Ident
    ;

/// How many times an operand is read: as many as please, at most once, at
/// least once, or a bounded number of times.
syntax Suffix ->
      '*'
    | '?'
    | '+'
    | Repeat
    ;

syntax ExprWithSuffix ->
      ExprWithoutSuffix Suffix
    | ExprWithoutSuffix 'concat' ExprNoTopAlt
    | ExprWithoutSuffix 'followed' ExprNoTopAlt
    | ExprWithoutSuffix 'except' ExprWithoutSuffix
    ;

/// The bounds a repetition is written with, which the reader of a pattern has
/// to tell apart: a number above, a number below, or a number of times.
syntax RepeatBound ->
      ',' LitDec
    | LitDec ',' LitDec?
    | LitDec
    ;

syntax Repeat -> '{' RepeatBound '}';

syntax Range ->
      LitUnicode concat '-' concat LitUnicode
    | LitStr concat '-' concat LitStr
    ;

syntax SetItem ->
      Range
    | LitStr
    | LitUnicode
    | Ident
    ;

syntax Stmt -> LeadingKeywords Ident '->' Expr ';';

syntax Item -> OuterDoc | S | Stmt;

syntax OuterDoc -> OuterBlockDoc | OuterLineDoc;

syntax InnerDoc -> InnerBlockDoc | InnerLineDoc;

syntax Crate -> InnerDoc* Item*;
